<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="using:System"
             xmlns:app="using:Scanword.Application"
             xmlns:controls="using:Scanword.Controls"
             xmlns:vm="using:Scanword.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Scanword.Views.MainView"
             x:DataType="vm:MainViewModel"
             Focusable="True">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="10">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="☰" Command="{Binding OpenLevelSelectCommand}" ToolTip.Tip="Выбор уровня"/>
        <Button Content="◀" Command="{Binding PreviousLevelCommand}" ToolTip.Tip="Предыдущий уровень"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding LevelTitle}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding LevelPosition}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
        </StackPanel>
        <Button Content="▶" Command="{Binding NextLevelCommand}" ToolTip.Tip="Следующий уровень"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Border Background="#FFF3D6" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
          <TextBlock Text="{Binding Coins, StringFormat='🪙 {0}'}" FontWeight="SemiBold"/>
        </Border>
        <Button Content="📺 +10" Command="{Binding WatchAdCommand}" ToolTip.Tip="Посмотреть рекламу за монеты"/>
        <Button Content="🛒" Command="{Binding OpenStoreCommand}" ToolTip.Tip="Магазин монет"/>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="2,8,2,4"
               FontSize="13" Opacity="0.8" TextWrapping="Wrap"/>

    <Border Grid.Row="2" Background="#ECEFF1" CornerRadius="8" Padding="6" Margin="0,4">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
          <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
          </LayoutTransformControl.LayoutTransform>
          <controls:ScanwordBoard x:Name="Board"
                                  Engine="{Binding GameEngine}"
                                  Revision="{Binding Revision}"
                                  CellTappedCommand="{Binding CellTappedCommand}"/>
        </LayoutTransformControl>
      </ScrollViewer>
    </Border>

    <ItemsControl Grid.Row="3" ItemsSource="{Binding KeyboardLetters}" HorizontalAlignment="Center">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" MaxWidth="560"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="sys:Char">
          <Button Content="{Binding}"
                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).InputLetterCommand}"
                  CommandParameter="{Binding}"
                  MinWidth="36" MinHeight="40" Margin="2"
                  HorizontalContentAlignment="Center"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
      <Button Content="⌫ Стереть" Command="{Binding EraseCommand}"/>
      <Button Content="💡 Буква (1)" Command="{Binding OpenLetterHintCommand}"/>
      <Button Content="💡 Слово (3)" Command="{Binding OpenWordHintCommand}"/>
    </StackPanel>

    <Panel Grid.Row="0" Grid.RowSpan="5" Background="#99000000" IsVisible="{Binding IsStoreOpen}">
      <Border Background="White" CornerRadius="12" Padding="20" MaxWidth="360"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="Магазин монет" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
          <ItemsControl ItemsSource="{Binding CoinPacks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:CoinPack">
                <Button Margin="0,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).BuyPackCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🪙"/>
                    <TextBlock Text="{Binding Title}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Восстановить покупки" Command="{Binding RestorePurchasesCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button Content="Закрыть" Command="{Binding CloseStoreCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>
    </Panel>

    <Panel Grid.Row="0" Grid.RowSpan="5" Background="#99000000" IsVisible="{Binding IsLevelSelectOpen}">
      <Border Background="White" CornerRadius="12" Padding="20" MaxWidth="420"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="Выбор уровня" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
          <ItemsControl ItemsSource="{Binding LevelItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LevelItemViewModel">
                <Button Margin="0,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectLevelCommand}"
                        CommandParameter="{Binding Index}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Закрыть" Command="{Binding CloseLevelSelectCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>
    </Panel>

  </Grid>
</UserControl>
